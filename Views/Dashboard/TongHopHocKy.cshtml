@using QuanLyHocSinhTHPT.Models
@model List<DiemTBResult>
@{
    ViewData["Title"] = "Tổng Hợp Học Kỳ";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    var danhSachLop = ViewBag.DanhSachLop as List<LopHoc> ?? new List<LopHoc>();
    
    int maLop = ViewBag.MaLop != null ? (int)ViewBag.MaLop : 101;
    int hocKy = ViewBag.HocKy != null ? (int)ViewBag.HocKy : 1;
    string namHoc = ViewBag.NamHoc?.ToString() ?? "2024-2025";
    string tenLop = ViewBag.TenLop?.ToString() ?? "N/A";
}

@section Styles {
    <link rel="stylesheet" href="~/css/scores.css" />
    <style>
        .tonghop-container {
            background: white;
            border-radius: 8px;
            padding: 20px;
            margin: 20px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .tonghop-header {
            margin-bottom: 30px;
            border-bottom: 3px solid #9b59b6;
            padding-bottom: 15px;
        }

        .tonghop-title {
            font-size: 24px;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 10px;
        }

        .tonghop-meta {
            font-size: 14px;
            color: #7f8c8d;
            line-height: 1.8;
        }

        .filter-section {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 6px;
        }

        .filter-group {
            display: flex;
            flex-direction: column;
        }

        .filter-group label {
            font-weight: bold;
            margin-bottom: 5px;
            color: #2c3e50;
            font-size: 13px;
        }

        .filter-group select {
            padding: 8px 10px;
            border: 1px solid #bdc3c7;
            border-radius: 4px;
            font-size: 13px;
        }

        .filter-group select:focus {
            outline: none;
            border-color: #9b59b6;
            box-shadow: 0 0 5px rgba(155, 89, 182, 0.3);
        }

        .btn-filter {
            background: #9b59b6;
            color: white;
            padding: 8px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            align-self: flex-end;
            transition: background 0.3s;
        }

        .btn-filter:hover {
            background: #8e44ad;
        }

        .tonghop-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
            font-size: 13px;
        }

        .tonghop-table thead {
            background: #34495e;
            color: white;
        }

        .tonghop-table th {
            padding: 12px;
            text-align: left;
            font-weight: bold;
            border: 1px solid #ddd;
        }

        .tonghop-table td {
            padding: 10px 12px;
            border: 1px solid #ecf0f1;
            vertical-align: middle;
        }

        .tonghop-table tbody tr:nth-child(even) {
            background: #f8f9fa;
        }

        .tonghop-table tbody tr:hover {
            background: #f4e4f4;
            transition: background 0.2s;
        }

        .rank-column {
            text-align: center;
            font-weight: bold;
            width: 60px;
        }

        .rank-1 { background: #f1c40f; color: #2c3e50; font-weight: bold; }
        .rank-2 { background: #e8daef; color: #2c3e50; }
        .rank-3 { background: #edbb99; color: #2c3e50; }

        .diem-column {
            text-align: right;
            font-weight: bold;
        }

        .diem-gioi { color: #27ae60; background: #d5f4e6; }
        .diem-kha { color: #3498db; background: #d6eaf8; }
        .diem-trungbinh { color: #f39c12; background: #fdebd0; }
        .diem-yeu { color: #e74c3c; background: #fadbd8; }

        .hanhkiem-badge {
            display: inline-block;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 11px;
            font-weight: bold;
            text-align: center;
            min-width: 80px;
        }

        .hanhkiem-tot { background: #d5f4e6; color: #27ae60; }
        .hanhkiem-kha { background: #d6eaf8; color: #3498db; }
        .hanhkiem-trungbinh { background: #fdebd0; color: #f39c12; }
        .hanhkiem-yeu { background: #fadbd8; color: #e74c3c; }

        .no-data {
            text-align: center;
            padding: 40px;
            color: #7f8c8d;
            font-size: 16px;
        }

        .table-summary {
            margin-top: 20px;
            padding: 15px;
            background: #ebe4f4;
            border-radius: 6px;
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
        }

        .summary-item {
            text-align: center;
        }

        .summary-label {
            font-size: 12px;
            color: #7f8c8d;
            margin-bottom: 5px;
        }

        .summary-value {
            font-size: 18px;
            font-weight: bold;
            color: #2c3e50;
        }

        .legend {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
            gap: 10px;
            margin-top: 20px;
            padding: 15px;
            background: #f0f0f0;
            border-radius: 6px;
            font-size: 12px;
        }

        .legend-item {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .legend-color {
            width: 20px;
            height: 20px;
            border-radius: 3px;
            border: 1px solid #ccc;
        }
    </style>
}

<div class="tonghop-container">
    <div class="tonghop-header">
        <div class="tonghop-title">📋 Tổng Hợp Học Kỳ</div>
        <div class="tonghop-meta">
            <strong>Lớp:</strong> @tenLop (Lớp @maLop)<br/>
            <strong>Học kỳ:</strong> HK @hocKy - Năm học @namHoc
        </div>
    </div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            ⚠️ @ViewBag.ErrorMessage
        </div>
    }

    <form method="get" action="/Dashboard/TongHopHocKy" class="filter-section">
        <div class="filter-group">
            <label for="maLop">Chọn Lớp:</label>
            <select name="maLop" id="maLop">
                @if (danhSachLop.Count > 0)
                {
                    @foreach (var lop in danhSachLop)
                    {
                        @if (lop.MaLop == maLop)
                        {
                            <option value="@lop.MaLop" selected>@lop.TenLop (@lop.SoHocSinh HS)</option>
                        }
                        else
                        {
                            <option value="@lop.MaLop">@lop.TenLop (@lop.SoHocSinh HS)</option>
                        }
                    }
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="hocKy">Học Kỳ:</label>
            <select name="hocKy" id="hocKy">
                @if (hocKy == 1)
                {
                    <option value="1" selected>Học kỳ 1</option>
                    <option value="2">Học kỳ 2</option>
                }
                else
                {
                    <option value="1">Học kỳ 1</option>
                    <option value="2" selected>Học kỳ 2</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <label for="namHoc">Năm Học:</label>
            <select name="namHoc" id="namHoc">
                @if (namHoc == "2024-2025")
                {
                    <option value="2024-2025" selected>2024-2025</option>
                    <option value="2023-2024">2023-2024</option>
                }
                else
                {
                    <option value="2024-2025">2024-2025</option>
                    <option value="2023-2024" selected>2023-2024</option>
                }
            </select>
        </div>

        <div class="filter-group">
            <button type="submit" class="btn-filter">🔍 Tìm Kiếm</button>
        </div>
    </form>

    @if (Model != null && Model.Count > 0)
    {
        <table class="tonghop-table">
            <thead>
                <tr>
                    <th style="width: 8%;">Xếp Hạng</th>
                    <th style="width: 30%;">Họ và Tên</th>
                    <th style="width: 15%;" class="diem-column">Điểm TB HK</th>
                    <th style="width: 18%;" class="diem-column">Xếp Loại Học Lực</th>
                    <th style="width: 18%;">Hành Kiểm</th>
                    <th style="width: 11%;">Ghi Chú</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rank = 1;
                    float? previousScore = null;
                    int displayRank = 1;
                }

                @foreach (var item in Model.OrderByDescending(x => x.DiemTB_HK))
                {
                    // Handle ties in ranking
                    if (previousScore.HasValue && previousScore != item.DiemTB_HK)
                    {
                        displayRank = rank;
                    }
                    previousScore = item.DiemTB_HK;

                    string rankClass = displayRank <= 3 ? $"rank-{displayRank}" : "";
                    string diemClass = item.DiemTB_HK >= 8 ? "diem-gioi" 
                                     : item.DiemTB_HK >= 6.5 ? "diem-kha" 
                                     : item.DiemTB_HK >= 5 ? "diem-trungbinh" 
                                     : "diem-yeu";

                    string xepLoai = item.DiemTB_HK >= 8 ? "Giỏi"
                                   : item.DiemTB_HK >= 6.5 ? "Khá"
                                   : item.DiemTB_HK >= 5 ? "Trung Bình"
                                   : "Yếu";

                    string hanhKiemClass = item.HanhKiem?.ToLower() switch
                    {
                        "tốt" => "hanhkiem-tot",
                        "khá" => "hanhkiem-kha",
                        "trung bình" => "hanhkiem-trungbinh",
                        "yếu" => "hanhkiem-yeu",
                        _ => "hanhkiem-trungbinh"
                    };

                    <tr class="@rankClass">
                        <td class="rank-column">
                            <strong>#@displayRank</strong>
                        </td>
                        <td>
                            <strong>@item.TenHocSinh</strong>
                        </td>
                        <td class="@diemClass">
                            @(item.DiemTB_HK?.ToString("0.00") ?? "Chưa có")
                        </td>
                        <td class="diem-column">
                            @xepLoai
                        </td>
                        <td>
                            <span class="hanhkiem-badge @hanhKiemClass">
                                @(string.IsNullOrEmpty(item.HanhKiem) ? "Chưa xếp" : item.HanhKiem)
                            </span>
                        </td>
                        <td style="font-size: 12px; color: #7f8c8d;">
                            @if (item.DiemTB_HK >= 8 && item.HanhKiem == "Tốt")
                            {
                                <span>✓ Xuất sắc</span>
                            }
                            else if (item.DiemTB_HK < 5)
                            {
                                <span>⚠ Yếu</span>
                            }
                        </td>
                    </tr>
                    rank++;
                }
            </tbody>
        </table>

        <div class="legend">
            <div class="legend-item">
                <div class="legend-color" style="background: #f1c40f;"></div>
                <span>Xếp hạng 1</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #e8daef;"></div>
                <span>Xếp hạng 2</span>
            </div>
            <div class="legend-item">
                <div class="legend-color" style="background: #edbb99;"></div>
                <span>Xếp hạng 3</span>
            </div>
            <div class="legend-item">
                <div class="legend-color diem-gioi"></div>
                <span>Giỏi (≥8.0)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color diem-kha"></div>
                <span>Khá (6.5-8.0)</span>
            </div>
            <div class="legend-item">
                <div class="legend-color diem-yeu"></div>
                <span>Yếu (&lt;5.0)</span>
            </div>
        </div>

        <div class="table-summary">
            <div class="summary-item">
                <div class="summary-label">Tổng Học Sinh</div>
                <div class="summary-value">@Model.Count</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Xếp Loại Giỏi</div>
                <div class="summary-value">@Model.Count(x => x.DiemTB_HK >= 8)</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Xếp Loại Khá</div>
                <div class="summary-value">@Model.Count(x => x.DiemTB_HK >= 6.5 && x.DiemTB_HK < 8)</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Xếp Loại Yếu</div>
                <div class="summary-value">@Model.Count(x => x.DiemTB_HK < 5)</div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Điểm TB Lớp</div>
                <div class="summary-value">
                    @{
                        var avgDiem = Model.Where(x => x.DiemTB_HK.HasValue).Average(x => x.DiemTB_HK);
                    }
                    @(((float?)avgDiem)?.ToString("0.00") ?? "-")
                </div>
            </div>
            <div class="summary-item">
                <div class="summary-label">Hành Kiểm Tốt</div>
                <div class="summary-value">@Model.Count(x => x.HanhKiem == "Tốt")</div>
            </div>
        </div>
    }
    else
    {
        <div class="no-data">
            <p>🔍 Không có dữ liệu tổng hợp cho lớp và học kỳ này.</p>
            <p style="font-size: 12px; margin-top: 10px;">Vui lòng chọn lớp và học kỳ khác hoặc kiểm tra dữ liệu trong hệ thống.</p>
        </div>
    }
</div>
