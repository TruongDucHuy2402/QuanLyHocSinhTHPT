@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="panel-title">🏠 Trang Chủ</div>

@if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
{
    <div class="welcome-box" style="background: #fff3cd; border-left: 4px solid #ffc107;">
        <p style="color: #856404;">⚠️ @ViewBag.ErrorMessage</p>
    </div>
}

<div class="welcome-box">
    <h2>👋 Chào mừng, @ViewBag.TenDangNhap!</h2>
    <p>Bạn đang sử dụng tài khoản với vai trò: <strong>@ViewBag.VaiTro</strong></p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-number">@ViewBag.TongHocSinh</div>
        <div class="stat-label">Tổng Học Sinh</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@ViewBag.SoLop</div>
        <div class="stat-label">Số Lớp</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@ViewBag.SoNam</div>
        <div class="stat-label">Học Sinh Nam</div>
    </div>
    <div class="stat-card">
        <div class="stat-number">@ViewBag.SoNu</div>
        <div class="stat-label">Học Sinh Nữ</div>
    </div>
</div>

<!-- Scores Section -->
@if (ViewBag.VaiTro == "HOCSINH" || ViewBag.VaiTro == "PHUHUYNH" || ViewBag.VaiTro == "GVCN" || ViewBag.VaiTro == "ADMIN" || ViewBag.VaiTro == "BGH")
{
    <div style="margin-top: 30px;">
        <div class="panel-title">📊 Điểm Số</div>
        <div class="quick-access" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; padding: 20px;">
        <a href="/Dashboard/Scores" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
            📈 Xem Điểm Học Kỳ
        </a>

        @if (ViewBag.VaiTro == "GVCN" || ViewBag.VaiTro == "ADMIN" || ViewBag.VaiTro == "BGH")
        {
            <a href="/Dashboard/Scores" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                👥 Phân Tích Điểm Lớp
            </a>

            <a href="/Dashboard/NhapDiem" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📝 Nhập Điểm
            </a>

            <a href="/Dashboard/DiemTBMon" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📘 Tính Điểm TB Môn
            </a>

            <a href="/Dashboard/DiemTBHK" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #06b6d4 0%, #0891b2 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📊 Tính Điểm TB Học Kỳ
            </a>

            <a href="/Dashboard/TongHopHocKy" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📋 Tổng Hợp Học Kỳ
            </a>

            <a href="/Dashboard/BangDiemLop" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #14b8a6 0%, #0f766e 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📑 Bảng Điểm Lớp
            </a>
        }
        </div>
        <p style="color: #999; font-size: 0.9rem; padding: 0 20px;">Quản lý và xem chi tiết điểm số học sinh</p>
    </div>
}

<!-- Classes Section -->
@if (ViewBag.VaiTro == "ADMIN" || ViewBag.VaiTro == "BGH")
{
    <div style="margin-top: 30px;">
        <div class="panel-title">📚 Danh Sách Lớp Học</div>
        <div class="quick-access" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 15px; padding: 20px;">
            <a href="/Dashboard/Classes" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #f59e0b 0%, #e74c3c 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📋 Xem Danh Sách Lớp
            </a>
            <a href="/Dashboard/Scores" class="quick-link" style="padding: 20px; background: linear-gradient(135deg, #8e44ad 0%, #3498db 100%); color: white; text-decoration: none; border-radius: 8px; text-align: center; font-weight: 600; transition: transform 0.3s ease;">
                📊 Phân Tích Lớp Học
            </a>
        </div>
        <p style="color: #999; font-size: 0.9rem; padding: 0 20px;">Quản lý lớp học và xem thống kê chi tiết</p>
    </div>
}
