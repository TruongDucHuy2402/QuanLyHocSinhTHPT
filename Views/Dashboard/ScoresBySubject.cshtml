@{
    ViewData["Title"] = "Chi Tiết Điểm Theo Môn";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";

    int maLop = ViewBag.MaLop ?? 1;
    int hocKy = ViewBag.HocKy ?? 1;
    string namHoc = ViewBag.NamHoc ?? "2024-2025";
}

@section Styles {
    <link rel="stylesheet" href="~/css/scores.css" />
    <link rel="stylesheet" href="~/css/tables.css" />
}

<div class="scores-container">
    <div class="panel-title">📊 Chi Tiết Điểm Theo Môn Học</div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
    }

    <!-- Back -->
    <div class="filter-section">
        <a href="/Dashboard/Scores?maLop=@maLop&hocKy=@hocKy&namHoc=@namHoc" class="btn-primary">
            ← Quay Lại
        </a>
    </div>

    <!-- Filter -->
    <div class="filter-section">
        <div class="filter-group">
            <label>Môn học:</label>
            <select id="monHoc" class="form-control"></select>
        </div>

        <div class="filter-group">
            <label>Loại điểm:</label>
            <select id="loaiDiem" class="form-control">
                <option value="">-- Tất cả --</option>
                <option value="1">Miệng</option>
                <option value="2">15 phút</option>
                <option value="3">1 tiết</option>
                <option value="4">Giữa kỳ</option>
                <option value="5">Cuối kỳ</option>
            </select>
        </div>
    </div>

    <!-- Statistics -->
    <div class="table-wrapper" id="statisticsSection" style="display:none;">
        <h3 class="section-title">📈 Thống Kê</h3>
        <table class="scores-table">
            <tr><td>Cao nhất</td><td id="maxScore"></td></tr>
            <tr><td>Thấp nhất</td><td id="minScore"></td></tr>
            <tr><td>Trung bình</td><td id="avgScore"></td></tr>
        </table>
    </div>

    <!-- Distribution -->
    <div class="table-wrapper" id="distributionSection" style="display:none;">
        <h3 class="section-title">📊 Phân Bố</h3>
        <table class="scores-table">
            <tr><td>Giỏi</td><td id="soGioi"></td><td id="tileGioi"></td></tr>
            <tr><td>Khá</td><td id="soKha"></td><td id="tileKha"></td></tr>
            <tr><td>Trung Bình</td><td id="soTB"></td><td id="tileTB"></td></tr>
            <tr><td>Yếu</td><td id="soYeu"></td><td id="tileYeu"></td></tr>
        </table>
    </div>
</div>

<script>
    const maLop = @maLop;
    const hocKy = @hocKy;
    const namHoc = "@namHoc";

    document.addEventListener("DOMContentLoaded", () => {
        loadSubjects();

        const url = new URLSearchParams(window.location.search);
        const maMon = url.get("maMon");

        if (maMon) {
            setTimeout(() => {
                document.getElementById("monHoc").value = maMon;
                loadData();
            }, 300);
        }
    });

    function loadSubjects() {
        fetch("/Dashboard/GetSubjects")
            .then(res => res.json())
            .then(data => {
                const select = document.getElementById("monHoc");
                select.innerHTML = '<option value="">-- chọn môn --</option>';

                data.forEach(m => {
                    select.innerHTML += `<option value="${m.maMon}">${m.tenMon}</option>`;
                });

                select.onchange = loadData;
                document.getElementById("loaiDiem").onchange = loadData;
            });
    }

    function loadData() {
        const maMon = document.getElementById("monHoc").value;
        const loaiDiem = document.getElementById("loaiDiem").value;

        if (!maMon) return;

        let url = `/Dashboard/GetScoreDistribution?maLop=${maLop}&maMon=${maMon}&hocKy=${hocKy}&namHoc=${namHoc}`;
        if (loaiDiem) url += `&loaiDiem=${loaiDiem}`;

        fetch(url)
            .then(res => res.json())
            .then(d => {
                if (d.error) return;

                document.getElementById("statisticsSection").style.display = "block";
                document.getElementById("distributionSection").style.display = "block";

                document.getElementById("maxScore").innerText = d.maxScore.toFixed(2);
                document.getElementById("minScore").innerText = d.minScore.toFixed(2);
                document.getElementById("avgScore").innerText = d.avgScore.toFixed(2);

                document.getElementById("soGioi").innerText = d.soGioi;
                document.getElementById("tileGioi").innerText = d.tiLeGioi.toFixed(1) + "%";

                document.getElementById("soKha").innerText = d.soKha;
                document.getElementById("tileKha").innerText = d.tiLeKha.toFixed(1) + "%";

                document.getElementById("soTB").innerText = d.soTrungBinh;
                document.getElementById("tileTB").innerText = d.tiLeTrungBinh.toFixed(1) + "%";

                document.getElementById("soYeu").innerText = d.soYeu;
                document.getElementById("tileYeu").innerText = d.tiLeYeu.toFixed(1) + "%";
            });
    }
</script>