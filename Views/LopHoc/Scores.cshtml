@{
    ViewData["Title"] = "Điểm Số Lớp";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<link rel="stylesheet" href="~/css/scores.css" />
<link rel="stylesheet" href="~/css/tables.css" />

<div class="scores-container">
    <div class="panel-title">📊 Điểm Số - Lớp @ViewBag.LopHoc?.TenLop</div>

    @if (ViewBag.ErrorMessage != null)
    {
        <div class="alert alert-danger">
            @ViewBag.ErrorMessage
        </div>
    }

    <!-- Navigation -->
    <div class="filter-section">
        <a href="/LopHoc/Details/@ViewBag.MaLop" class="btn-primary">← Chi Tiết Lớp</a>
        <a href="/LopHoc/Students/@ViewBag.MaLop" class="btn-primary" style="margin-left: 10px;">👥 Danh Sách HS</a>
    </div>

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="filter-group">
            <label>Học Kỳ:</label>
            <select id="hocKy" class="form-control">
                <option value="1" @(ViewBag.HocKy == 1 ? "selected" : "")>Học Kỳ 1</option>
                <option value="2" @(ViewBag.HocKy == 2 ? "selected" : "")>Học Kỳ 2</option>
            </select>
        </div>
        <div class="filter-group">
            <label>Năm Học:</label>
            <input type="text" id="namHoc" class="form-control" value="@ViewBag.NamHoc" />
        </div>
        <button class="btn-primary" onclick="reloadScores()">🔄 Tải Lại</button>
    </div>

    <!-- Summary Cards -->
    <div class="summary-section">
        <div class="summary-card">
            <div class="card-title">📚 Khối @ViewBag.LopHoc?.KhoiLop</div>
            <div class="card-value">@ViewBag.LopHoc?.TenLop</div>
        </div>
        <div class="summary-card">
            <div class="card-title">👥 Tổng Số Học Sinh</div>
            <div class="card-value">@ViewBag.TongHocSinh</div>
        </div>
        <div class="summary-card">
            <div class="card-title">📊 Tổng Số Môn Học</div>
            <div class="card-value">@ViewBag.TongMon</div>
        </div>
        <div class="summary-card">
            <div class="card-title">⭐ Điểm TB Chung</div>
            <div class="card-value">@ViewBag.DiemTBChung</div>
        </div>
    </div>

    <!-- Scores Table -->
    <div class="table-wrapper">
        <h3 class="section-title">📋 Bảng Điểm Trung Bình Các Môn Học</h3>
        
        @if (ViewBag.DiemTheoMon != null && ((List<QuanLyHocSinhTHPT.Models.DiemMonTBResult>)ViewBag.DiemTheoMon).Count > 0)
        {
            <table class="scores-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th class="col-mon">Tên Môn Học</th>
                        <th class="col-diem">Điểm TB</th>
                        <th class="col-xep-loai">Xếp Loại</th>
                        <th class="col-so-dat">Số HS Đạt</th>
                        <th class="col-ti-le">% Đạt</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int stt = 1;
                        foreach (var item in (List<QuanLyHocSinhTHPT.Models.DiemMonTBResult>)ViewBag.DiemTheoMon)
                        {
                            var diemTB = item.DiemTB_Mon ?? 0;
                            var cssClass = diemTB >= 8 ? "excellent" 
                                         : diemTB >= 6.5 ? "good"
                                         : diemTB >= 5 ? "average"
                                         : "poor";
                            <tr class="score-row @cssClass">
                                <td class="col-stt">@stt</td>
                                <td class="col-mon">@item.TenMon</td>
                                <td class="col-diem score-value">
                                    @if (item.DiemTB_Mon.HasValue)
                                    {
                                        @String.Format("{0:F2}", item.DiemTB_Mon)
                                    }
                                    else
                                    {
                                        <text>---</text>
                                    }
                                </td>
                                <td class="col-xep-loai">
                                    @if (!string.IsNullOrEmpty(item.XepLoai))
                                    {
                                        <span class="badge badge-@item.XepLoai.ToLower().Replace(' ', '-')">
                                            @item.XepLoai
                                        </span>
                                    }
                                </td>
                                <td class="col-so-dat">@item.SoHocSinhDat/@item.TongHocSinh</td>
                                <td class="col-ti-le">
                                    <div class="progress-bar">
                                        <div class="progress-fill" style="width: @String.Format("{0:F0}", item.TiLeDat)%">
                                            @String.Format("{0:F0}", item.TiLeDat)%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            stt++;
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-data">
                <p>Không có dữ liệu điểm số cho lớp này</p>
            </div>
        }
    </div>

    <!-- Students Scores -->
    <div class="table-wrapper" style="margin-top: 30px;">
        <h3 class="section-title">👥 Danh Sách Học Sinh</h3>
        
        @if (ViewBag.DanhSachHS != null && ((List<QuanLyHocSinhTHPT.Models.HocSinh>)ViewBag.DanhSachHS).Count > 0)
        {
            <table class="students-table">
                <thead>
                    <tr>
                        <th class="col-stt">STT</th>
                        <th class="col-ma-hs">Mã HS</th>
                        <th class="col-ho-ten">Họ Tên</th>
                        <th class="col-diem-tb">Điểm TB</th>
                        <th class="col-hanh-kiem">Hạnh Kiểm</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        int hsIndex = 1;
                        foreach (var hs in (List<QuanLyHocSinhTHPT.Models.HocSinh>)ViewBag.DanhSachHS)
                        {
                            var hanhKiemClass = hs.HanhKiem == "Tốt" ? "badge-good"
                                              : hs.HanhKiem == "Khá" ? "badge-notice"
                                              : "badge-bad";
                            <tr>
                                <td class="col-stt">@hsIndex</td>
                                <td class="col-ma-hs">@hs.MaHS</td>
                                <td class="col-ho-ten">@hs.HoTen</td>
                                <td class="col-diem-tb">
                                    @if (hs.DiemTB.HasValue)
                                    {
                                        @String.Format("{0:F2}", hs.DiemTB)
                                    }
                                    else
                                    {
                                        <text>---</text>
                                    }
                                </td>
                                <td class="col-hanh-kiem">
                                    <span class="badge @hanhKiemClass">@(hs.HanhKiem ?? "Chưa xếp loại")</span>
                                </td>
                            </tr>
                            hsIndex++;
                        }
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="no-data">
                <p>Không có dữ liệu học sinh</p>
            </div>
        }
    </div>
</div>

<script>
    function reloadScores() {
        const hocKy = document.getElementById('hocKy').value;
        const namHoc = document.getElementById('namHoc').value;
        window.location.href = `/LopHoc/Scores/@ViewBag.MaLop?hocKy=${hocKy}&namHoc=${encodeURIComponent(namHoc)}`;
    }
</script>
